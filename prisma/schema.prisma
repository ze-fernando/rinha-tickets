generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Status {
  OPEN
  IN_PROGRESS
  CLOSED
}

model Ticket {
  id          Int      @id @default(autoincrement())
  title       String   @unique
  description String
  sector      String
  status      Status @default(OPEN)
  finishedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
